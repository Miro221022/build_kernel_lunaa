name: Build kernel (lunaa)

# Values below come from the device trees of theleafir1 (branch lineage-23.2):
#   BoardConfigCommon.mk : TARGET_KERNEL_CONFIG := vendor/lahaina-qgki_defconfig
#                          BOARD_KERNEL_IMAGE_NAME := Image, boot header v3
#   BoardConfig.mk (lunaa): TARGET_KERNEL_CONFIG += vendor/oplus_yupik_QGKI.config
#
# IMPORTANT: this kernel tree already ships KernelSU Next (drivers/kernelsu),
# SUSFS v2.1.0 (fs/susfs.c, include/linux/susfs*.h), the manual hooks in fs/*
# and the KSU/SUSFS options in lahaina-qgki_defconfig. Nothing must be
# downloaded or patched on top of it (that was the cause of the previous
# failures). The only thing needed for kernel 5.4 is the pgtable.h fix below.
#
# ksu_source=latest replaces ONLY drivers/kernelsu with the newest KernelSU Next
# that supports 5.4 + SUSFS and ports the one hook the old tree needs.
# ksu_source=official-tag uses the official KernelSU-Next/KernelSU-Next repo at
# the tag given in ksu_tag (default v3.4.2). Like official-legacy it has NO SUSFS
# glue, so the built-in SUSFS core is kept (SUSFS hiding will not work).
# ksu_source=official-legacy uses KernelSU-Next/KernelSU-Next branch 'legacy'
# (newest, includes fixes ported from 3.4.x) but it has NO SUSFS support.
# susfs_source=latest replaces ONLY the SUSFS core of the tree (fs/susfs.c and
# include/linux/susfs*.h) with the newest SUSFS from susfs_repo/susfs_branch;
# the hooks already present in fs/* stay as they are.
# Fallback chain if the build fails: 1) built-in SUSFS, 2) built-in KernelSU.

on:
  workflow_dispatch:
    inputs:
      kernel_repo:
        description: "Kernel repo (owner/name)"
        required: true
        default: "theleafir1/android_kernel_oneplus_sm8350"
      kernel_branch:
        description: "Branch (empty = repo default: lineage-23-base-lunaa-rebase-qualle)"
        required: false
        default: ""
      defconfig:
        description: "Base defconfig"
        required: true
        default: "vendor/lahaina-qgki_defconfig"
      extra_configs:
        description: "Config fragments merged on top (lunaa needs oplus_yupik)"
        required: false
        default: "vendor/oplus_yupik_QGKI.config"
      scmversion:
        description: "Kernel release suffix, must match the ROM's modules (see 'adb shell uname -r'). Empty = -g<12-char HEAD hash>"
        required: false
        default: ""
      ksu:
        description: "Build with KernelSU Next (false = CONFIG_KSU off)"
        type: boolean
        required: true
        default: true
      ksu_source:
        description: "official-tag = official KernelSU-Next at the tag in ksu_tag (e.g. v3.4.2), NO SUSFS glue; latest = KernelSU Next from ksu_repo/ksu_branch with SUSFS (auto-falls back to the built-in one if it does not build); official-legacy = newest official KernelSU-Next 'legacy' branch, NO SUSFS glue (SUSFS hiding will not work); builtin = version already in the kernel tree"
        type: choice
        required: true
        default: "official-tag"
        options:
          - official-tag
          - latest
          - official-legacy
          - builtin
      ksu_tag:
        description: "Tag for ksu_source=official-tag (KernelSU-Next/KernelSU-Next)"
        required: false
        default: "v3.4.2"
      ksu_repo:
        description: "Repo for 'latest' (newest KernelSU Next for non-GKI 5.4 with SUSFS support)"
        required: true
        default: "sidex15/KernelSU-Next"
      ksu_branch:
        description: "Branch for 'latest'"
        required: true
        default: "legacy-susfs-v2"
      susfs_source:
        description: "latest = newest SUSFS core from susfs_repo (auto-falls back to the built-in one if it does not build), builtin = SUSFS already in the kernel tree"
        type: choice
        required: true
        default: "latest"
        options:
          - latest
          - builtin
      susfs_repo:
        description: "SUSFS git repo for 'latest' (must contain kernel_patches/fs/susfs.c and kernel_patches/include/linux/susfs.h)"
        required: true
        default: "https://gitlab.com/simonpunk/susfs4ksu.git"
      susfs_branch:
        description: "SUSFS branch for 'latest' (the one matching kernel 5.4)"
        required: true
        default: "kernel-5.4"
      clang_repo:
        description: "Clang toolchain git repo"
        required: true
        default: "https://github.com/kdrag0n/proton-clang"
      clang_branch:
        description: "Clang branch"
        required: true
        default: "master"

jobs:
  build:
    runs-on: ubuntu-22.04
    timeout-minutes: 180

    steps:
      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          df -h /

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            bc bison flex libssl-dev libelf-dev libncurses-dev \
            cpio zip unzip git make gcc ccache lz4 zstd python3 \
            gcc-aarch64-linux-gnu gcc-arm-linux-gnueabi

      - name: Clone kernel source
        env:
          KERNEL_REPO: ${{ inputs.kernel_repo }}
          KERNEL_BRANCH: ${{ inputs.kernel_branch }}
        run: |
          BRANCH_ARG=""
          if [ -n "$KERNEL_BRANCH" ]; then
            BRANCH_ARG="-b $KERNEL_BRANCH"
          fi
          git clone --depth=1 --recurse-submodules $BRANCH_ARG \
            "https://github.com/$KERNEL_REPO" kernel
          ls kernel/arch/arm64/configs/vendor | grep -E "lahaina|yupik" || true
          touch build.log

      - name: Set kernel release suffix
        working-directory: kernel
        env:
          SCMVERSION: ${{ inputs.scmversion }}
        run: |
          # Vendor modules in vendor_dlkm are matched by version magic, so the
          # kernel release string must equal the one the ROM was built with.
          # Done before any file in the tree is touched (avoids a "-dirty" suffix).
          if [ -n "$SCMVERSION" ]; then
            SUFFIX="$SCMVERSION"
          else
            SUFFIX="-g$(git rev-parse --short=12 HEAD)"
          fi
          printf '%s' "$SUFFIX" > .scmversion
          echo "scmversion: $SUFFIX"

      - name: Prepare SUSFS
        if: inputs.ksu
        working-directory: kernel
        env:
          SUSFS_SOURCE: ${{ inputs.susfs_source }}
          SUSFS_REPO: ${{ inputs.susfs_repo }}
          SUSFS_BRANCH: ${{ inputs.susfs_branch }}
          KSU_SOURCE: ${{ inputs.ksu_source }}
          GIT_TERMINAL_PROMPT: "0"
        run: |
          set -uo pipefail
          exec > >(tee -a "$GITHUB_WORKSPACE/build.log") 2>&1

          echo "== built-in SUSFS"
          ls fs/susfs.c include/linux/susfs*.h
          grep -n "define SUSFS_VERSION" include/linux/susfs.h || true

          # keep the SUSFS core of the tree so the Build step can fall back to it
          rm -rf "$GITHUB_WORKSPACE/susfs_builtin"
          mkdir -p "$GITHUB_WORKSPACE/susfs_builtin/fs" "$GITHUB_WORKSPACE/susfs_builtin/include/linux"
          cp -a fs/susfs.c "$GITHUB_WORKSPACE/susfs_builtin/fs/"
          cp -a include/linux/susfs*.h "$GITHUB_WORKSPACE/susfs_builtin/include/linux/"

          cat > "$GITHUB_WORKSPACE/restore_susfs.sh" <<'EOS'
          set -e
          cd "$GITHUB_WORKSPACE/kernel"
          rm -f include/linux/susfs*.h
          cp -a "$GITHUB_WORKSPACE/susfs_builtin/fs/susfs.c" fs/susfs.c
          cp -a "$GITHUB_WORKSPACE/susfs_builtin/include/linux/." include/linux/
          EOS

          try_latest_susfs() {
            rm -rf "$GITHUB_WORKSPACE/susfs_latest"
            git clone --depth=1 -b "$SUSFS_BRANCH" "$SUSFS_REPO" "$GITHUB_WORKSPACE/susfs_latest" || return 1
            P="$GITHUB_WORKSPACE/susfs_latest/kernel_patches"
            if [ ! -f "$P/fs/susfs.c" ] || [ ! -f "$P/include/linux/susfs.h" ]; then
              echo "unexpected SUSFS repo layout"
              return 1
            fi
            cp -a "$P/fs/susfs.c" fs/susfs.c
            rm -f include/linux/susfs*.h
            cp -a "$P"/include/linux/susfs*.h include/linux/
            git -C "$GITHUB_WORKSPACE/susfs_latest" log -1 --format='SUSFS commit: %h %ad %s' --date=short
            grep -n "define SUSFS_VERSION" include/linux/susfs.h || true
          }

          if [ "$KSU_SOURCE" = "official-legacy" ] || [ "$KSU_SOURCE" = "official-tag" ]; then
            echo "official KernelSU-Next has no SUSFS glue - keeping the built-in SUSFS"
            SUSFS_SOURCE=builtin
          fi

          SUSFS_USED=builtin
          if [ "$SUSFS_SOURCE" = "latest" ]; then
            if try_latest_susfs; then
              SUSFS_USED=latest
            else
              echo "::warning::Could not set up the latest SUSFS - using the built-in version"
              bash "$GITHUB_WORKSPACE/restore_susfs.sh"
            fi
          fi
          echo "SUSFS_USED=$SUSFS_USED" >> "$GITHUB_ENV"
          echo "SUSFS source in use: $SUSFS_USED"

      - name: Prepare KernelSU Next
        if: inputs.ksu
        working-directory: kernel
        env:
          KSU_SOURCE: ${{ inputs.ksu_source }}
          KSU_REPO: ${{ inputs.ksu_repo }}
          KSU_BRANCH: ${{ inputs.ksu_branch }}
          KSU_TAG: ${{ inputs.ksu_tag }}
        run: |
          set -uo pipefail
          exec > >(tee -a "$GITHUB_WORKSPACE/build.log") 2>&1

          if [ "$KSU_SOURCE" = "official-tag" ]; then
            KSU_REPO="KernelSU-Next/KernelSU-Next"
            KSU_BRANCH="${KSU_TAG:-v3.4.2}"   # git clone -b accepts tags too
            KSU_SOURCE="latest"
            echo "::warning::official-tag selected ($KSU_BRANCH): official KernelSU-Next has no SUSFS support"
          elif [ "$KSU_SOURCE" = "official-legacy" ]; then
            KSU_REPO="KernelSU-Next/KernelSU-Next"
            KSU_BRANCH="legacy"
            KSU_SOURCE="latest"
            echo "::warning::official-legacy selected: this KernelSU Next has no SUSFS support"
          fi

          echo "== built-in KernelSU / SUSFS"
          ls -d drivers/kernelsu fs/susfs.c include/linux/susfs.h
          grep -n "define SUSFS_VERSION" include/linux/susfs.h || true

          # Kernel 5.4 has no linux/pgtable.h (added in 5.8); asm/pgtable.h is the 5.4 equivalent.
          fix_pgtable() {
            if [ ! -f include/linux/pgtable.h ]; then
              grep -rl 'linux/pgtable.h' "$1" 2>/dev/null | xargs -r sed -i 's|<linux/pgtable.h>|<asm/pgtable.h>|'
              echo "pgtable.h include fixed in $1"
            fi
          }

          fix_pgtable drivers/kernelsu
          rm -rf "$GITHUB_WORKSPACE/ksu_builtin"
          cp -a drivers/kernelsu "$GITHUB_WORKSPACE/ksu_builtin"

          # helper used by the Build step to fall back to the built-in version
          cat > "$GITHUB_WORKSPACE/restore_builtin.sh" <<'EOS'
          set -e
          cd "$GITHUB_WORKSPACE/kernel"
          rm -rf drivers/kernelsu KernelSU-Next
          cp -a "$GITHUB_WORKSPACE/ksu_builtin" drivers/kernelsu
          EOS
          sed -i 's/^          //' "$GITHUB_WORKSPACE/restore_builtin.sh"

          try_latest() {
            rm -rf KernelSU-Next
            # full clone on purpose: Kbuild derives version and tag from git history
            git clone --single-branch -b "$KSU_BRANCH" "https://github.com/$KSU_REPO" KernelSU-Next || return 1
            [ -d KernelSU-Next/kernel/core ] || return 1
            rm -rf drivers/kernelsu
            ln -sfn ../KernelSU-Next/kernel drivers/kernelsu
            fix_pgtable KernelSU-Next/kernel

            # ---- kernel 5.4 compatibility for the newest official KernelSU-Next (v3.x) ----
            # 1) seccomp_cache.c mirrors the seccomp ACTION CACHE of Linux 5.11+
            #    (SECCOMP_ARCH_NATIVE_NR, struct action_cache). This 5.4 tree has no such
            #    cache, so there is nothing to clear or allow: make both helpers no-ops.
            if [ -f KernelSU-Next/kernel/infra/seccomp_cache.c ] \
               && ! grep -rqsE "define[[:space:]]+SECCOMP_ARCH_NATIVE_NR" include arch/arm64/include; then
          cat > KernelSU-Next/kernel/infra/seccomp_cache.c <<'EOS'
          #include <linux/types.h>
          #include <linux/seccomp.h>
          #include "infra/seccomp_cache.h"

          /* kernel without seccomp action cache (< 5.11): nothing to do */
          void ksu_seccomp_clear_cache(struct seccomp_filter *filter, int nr)
          {
          }

          void ksu_seccomp_allow_cache(struct seccomp_filter *filter, int nr)
          {
          }
          EOS
              echo "seccomp_cache.c replaced by a no-op (no seccomp action cache in this kernel)"
            fi

            # 2) The syscall-table generation of KernelSU-Next hooks everything itself and no
            #    longer provides the manual-hook symbols this tree references. fs/read_write.c
            #    uses two of them under plain CONFIG_KSU (the SUSFS hooks in fs/* and kernel/*
            #    are compiled out because only the built-in Kconfig defines CONFIG_KSU_SUSFS).
            #    Provide them as inert stubs: the static key stays off, so the hook is never hit.
            SYSCALL_GEN=0
            if [ -f KernelSU-Next/kernel/hook/syscall_hook_manager.c ] \
               && ! grep -rq "ksu_init_rc_hook_key_false" KernelSU-Next/kernel; then
              SYSCALL_GEN=1
          cat > KernelSU-Next/kernel/infra/legacy_hook_shim.c <<'EOS'
          #include <linux/jump_label.h>
          #include <linux/compiler.h>

          /* referenced by fs/read_write.c of this tree; never enabled */
          DEFINE_STATIC_KEY_FALSE(ksu_init_rc_hook_key_false);

          __attribute__((cold)) int ksu_handle_sys_read(unsigned int fd)
          {
              return 0;
          }
          EOS
              sed -i 's|^kernelsu-objs += infra/seccomp_cache.o$|&\nkernelsu-objs += infra/legacy_hook_shim.o|' KernelSU-Next/kernel/Kbuild
              grep -q "legacy_hook_shim.o" KernelSU-Next/kernel/Kbuild || { echo "legacy_hook_shim Kbuild patch failed"; return 1; }
              echo "legacy hook shim added"
            fi

            # The newest KernelSU schedules 'susfs_extra_works', a work_struct that only
            # exists in SUSFS 2.0 (link error: undefined symbol susfs_extra_works).
            # SUSFS 2.1.0 in this tree exposes the same job as susfs_run_sus_path_loop(),
            # which is what the built-in KernelSU calls, so provide the work item here.
            SH=KernelSU-Next/kernel/hook/setuid_hook.c
            if grep -q '^extern struct work_struct susfs_extra_works;' "$SH" \
               && ! grep -rq "susfs_extra_works" include/linux fs/susfs.c; then
          cat > "$GITHUB_WORKSPACE/susfs_extra_works_shim.c" <<'EOS'
          #ifdef CONFIG_KSU_SUSFS_SUS_PATH
          extern void susfs_run_sus_path_loop(void);
          #endif
          static void susfs_extra_works_fn(struct work_struct *work)
          {
          #ifdef CONFIG_KSU_SUSFS_SUS_PATH
              susfs_run_sus_path_loop();
          #endif
          }
          static DECLARE_WORK(susfs_extra_works, susfs_extra_works_fn);
          EOS
              sed -i "/^extern struct work_struct susfs_extra_works;/{
          r $GITHUB_WORKSPACE/susfs_extra_works_shim.c
          d
          }" "$SH"
              grep -q "DECLARE_WORK(susfs_extra_works" "$SH" || { echo "susfs_extra_works shim failed"; return 1; }
              echo "susfs_extra_works shim added"
            fi

            # fs/stat.c of this tree calls ksu_handle_vfs_fstat() (adjusts init.rc size
            # so the injected ksud rc is read completely). Newer KernelSU dropped it,
            # so port the function from the built-in version instead of stubbing it.
            if [ "$SYSCALL_GEN" = "0" ] && ! grep -rq "ksu_handle_vfs_fstat" KernelSU-Next/kernel; then
              awk '/^void ksu_handle_vfs_fstat/{p=1} p{print} p&&/^}/{exit}' \
                "$GITHUB_WORKSPACE/ksu_builtin/runtime/ksud_integration.c" > "$GITHUB_WORKSPACE/vfs_fstat.c"
              [ -s "$GITHUB_WORKSPACE/vfs_fstat.c" ] || { echo "could not extract ksu_handle_vfs_fstat"; return 1; }
              {
                echo
                echo "/* ported from the built-in KernelSU: called from fs/stat.c of this kernel tree */"
                cat "$GITHUB_WORKSPACE/vfs_fstat.c"
              } >> KernelSU-Next/kernel/runtime/ksud_integration.c
              echo "ksu_handle_vfs_fstat ported"
            fi
            git -C KernelSU-Next log -1 --format='KernelSU-Next commit: %h %ad %s'
            git -C KernelSU-Next describe --tags --always 2>/dev/null || true
          }

          KSU_USED=builtin
          if [ "$KSU_SOURCE" = "latest" ]; then
            if try_latest; then
              KSU_USED=latest
            else
              echo "::warning::Could not set up the latest KernelSU Next - using the built-in version"
              bash "$GITHUB_WORKSPACE/restore_builtin.sh"
            fi
          fi
          echo "KSU_USED=$KSU_USED" >> "$GITHUB_ENV"
          echo "KernelSU source in use: $KSU_USED"

      - name: Clone clang
        run: |
          git clone --depth=1 -b "${{ inputs.clang_branch }}" \
            "${{ inputs.clang_repo }}" clang
          echo "$GITHUB_WORKSPACE/clang/bin" >> "$GITHUB_PATH"

      - name: Configure
        working-directory: kernel
        env:
          DEFCONFIG: ${{ inputs.defconfig }}
          EXTRA_CONFIGS: ${{ inputs.extra_configs }}
          WANT_KSU: ${{ inputs.ksu }}
        run: |
          export ARCH=arm64 SUBARCH=arm64
          MK="make O=out CC=clang LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi-"

          gen_defconfig() {
            $MK "$DEFCONFIG"
            for frag in $EXTRA_CONFIGS; do
              $MK "$frag"
            done
          }

          # .config.builtin (used if we have to fall back) must be generated against the
          # BUILT-IN Kconfig. With another KernelSU linked into drivers/kernelsu its Kconfig
          # does not know KSU_MANUAL_HOOK / KSU_SUSFS*, so those lines would be dropped and
          # the built-in code would later be built in the wrong hook mode (Kprobes ->
          # "use of undeclared identifier 'ksu_vfs_read_hook'").
          if [ "${KSU_USED:-builtin}" != "builtin" ]; then
            rm -rf drivers/.ksu_cur
            mv drivers/kernelsu drivers/.ksu_cur
            cp -a "$GITHUB_WORKSPACE/ksu_builtin" drivers/kernelsu
            gen_defconfig
            cp out/.config out/.config.builtin
            rm -rf drivers/kernelsu
            mv drivers/.ksu_cur drivers/kernelsu
          fi
          gen_defconfig
          [ -f out/.config.builtin ] || cp out/.config out/.config.builtin

          if [ "$WANT_KSU" != "true" ]; then
            scripts/config --file out/.config -d KSU
            $MK olddefconfig
          elif [ "${KSU_USED:-builtin}" = "latest" ]; then
            $MK olddefconfig
            cp out/.config out/.config.latest
            # the newest KernelSU expects the SUSFS 2.0 try_umount / memfd API,
            # the SUSFS v2.1.0 in this tree does not provide it: .config.compat is
            # the config for latest KernelSU + built-in SUSFS
            scripts/config --file out/.config -d KSU_SUSFS_TRY_UMOUNT -d KSU_SUSFS_SUS_MEMFD
            $MK olddefconfig
            cp out/.config out/.config.compat
            if [ "${SUSFS_USED:-builtin}" = "latest" ]; then
              cp out/.config.latest out/.config
            fi
          fi

          echo "--- resulting KernelSU / SUSFS config"
          grep -E "^CONFIG_(KSU|KPROBES)" out/.config || true

          if [ "$WANT_KSU" = "true" ]; then
            grep -q '^CONFIG_KSU=y' out/.config || { echo "::error::CONFIG_KSU is not enabled"; exit 1; }
            grep -q '^CONFIG_KSU_SUSFS=y' out/.config || echo "::warning::CONFIG_KSU_SUSFS is not enabled"
          fi

      - name: Build
        working-directory: kernel
        run: |
          export ARCH=arm64 SUBARCH=arm64
          MK="make O=out CC=clang LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi-"

          # without pipefail the exit code of 'tee' hides a failed make
          set -o pipefail
          build() { $MK -j"$(nproc)" Image modules 2>&1 | tee -a ../build.log; }

          OK=0
          build && OK=1

          if [ "$OK" = "0" ] && [ "${SUSFS_USED:-builtin}" = "latest" ]; then
            echo "::warning::Build failed with the latest SUSFS - falling back to the built-in SUSFS"
            grep -nE "error:|\*\*\*|undefined reference" ../build.log | head -15 || true
            bash "$GITHUB_WORKSPACE/restore_susfs.sh"
            if [ "${KSU_USED:-builtin}" = "latest" ]; then
              cp out/.config.compat out/.config
            else
              cp out/.config.builtin out/.config
            fi
            $MK olddefconfig
            SUSFS_USED=builtin
            echo "SUSFS_USED=builtin" >> "$GITHUB_ENV"
            build && OK=1
          fi

          if [ "$OK" = "0" ] && [ "${KSU_USED:-builtin}" = "latest" ]; then
            echo "::warning::Build failed with the latest KernelSU Next - falling back to the built-in version"
            grep -nE "error:|\*\*\*|undefined reference" ../build.log | head -15 || true
            bash "$GITHUB_WORKSPACE/restore_builtin.sh"
            cp out/.config.builtin out/.config
            $MK olddefconfig
            echo "KSU_USED=builtin" >> "$GITHUB_ENV"
            build && OK=1
          fi

          FAILED=0
          [ "$OK" = "1" ] || FAILED=1

          if [ "$FAILED" = "1" ]; then
            echo "::group::First errors"
            grep -nE "error:|\*\*\*|undefined reference" ../build.log | head -20 || true
            echo "::endgroup::"
            echo "::group::Single-threaded re-run for a readable error"
            $MK -j1 Image 2>&1 | tail -n 40 || true
            echo "::endgroup::"
            echo "::error::Kernel build failed - see the first errors above and the build-log artifact"
            exit 1
          fi

          $MK -j"$(nproc)" dtbs 2>&1 | tee -a ../build.log || true
          echo "Kernel release: $(cat out/include/config/kernel.release)"

      - name: Package AnyKernel3 zip
        run: |
          git clone --depth=1 https://github.com/osm0sis/AnyKernel3 ak3
          rm -rf ak3/.git ak3/README.md ak3/LICENSE
          cat > ak3/anykernel.sh <<'AKEOF'
          ### AnyKernel3 Ramdisk Mod Script
          properties() { '
          kernel.string=Custom kernel for lunaa (KernelSU Next + SUSFS)
          do.devicecheck=0
          do.modules=0
          do.systemless=0
          do.cleanup=1
          do.cleanuponabort=0
          device.name1=lunaa
          supported.versions=
          supported.patchlevels=
          supported.vendorpatchlevels=
          '; }

          BLOCK=boot;
          IS_SLOT_DEVICE=auto;
          RAMDISK_COMPRESSION=none;
          PATCH_VBMETA_FLAG=auto;
          NO_MAGISK_CHECK=1;

          . tools/ak3-core.sh;

          # The stock boot ramdisk is lz4_legacy and magiskboot's decompression
          # of it aborts ("Splitting image failed"). Only the kernel is replaced,
          # so keep the ramdisk bytes untouched: unpack with -n (no decompress);
          # RAMDISK_COMPRESSION=none above makes repack use -n as well.
          magiskboot() {
            if [ "$1" = unpack ]; then
              shift;
              "$BIN/magiskboot" unpack -n "$@";
            else
              "$BIN/magiskboot" "$@";
            fi;
          }

          split_boot;
          flash_boot;
          AKEOF
          sed -i 's/^          //' ak3/anykernel.sh
          cp kernel/out/arch/arm64/boot/Image ak3/Image
          cd ak3
          zip -r9 "../lunaa-kernel-$(date +%Y%m%d).zip" . -x '.git*'

      - name: Collect modules
        run: |
          mkdir -p extra/modules
          cp kernel/out/include/config/kernel.release extra/ || true
          cp kernel/out/.config extra/config || true
          find kernel/out -name '*.ko' -exec cp {} extra/modules/ \; 2>/dev/null || true
          echo "Built modules: $(ls extra/modules | wc -l)"

      - name: Summary
        if: always()
        run: |
          {
            echo "### Build summary"
            echo "- Kernel release: \`$(cat kernel/out/include/config/kernel.release 2>/dev/null || echo n/a)\`"
            echo "- KernelSU source: ${KSU_USED:-none} ($(git -C kernel/KernelSU-Next log -1 --format='%h %ad' --date=short 2>/dev/null || echo 'built-in'))"
            echo "- SUSFS source: ${SUSFS_USED:-none} ($(grep -h '#define SUSFS_VERSION' kernel/include/linux/susfs.h 2>/dev/null || echo 'n/a'))"
            grep -E "^CONFIG_KSU" kernel/out/.config 2>/dev/null | sed 's/^/    /' || true
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Upload boot.img and zip
        uses: actions/upload-artifact@v4
        with:
          name: lunaa-kernel
          path: |
            lunaa-kernel-*.zip

      - name: Upload config, release string and modules
        uses: actions/upload-artifact@v4
        with:
          name: lunaa-config-and-modules
          path: extra/

      - name: Upload build log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: build-log
          path: build.log
          if-no-files-found: ignore
